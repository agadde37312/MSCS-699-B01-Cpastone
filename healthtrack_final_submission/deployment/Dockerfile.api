FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY migrations/ ./migrations/
COPY alembic.ini .

# Model artifact is trained ahead of time and shipped in the image;
# see scripts/train_risk_model.py to regenerate it.
# (app/risk_model.joblib is copied via the app/ directory above)

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
