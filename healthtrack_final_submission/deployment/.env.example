# HealthTrack environment configuration
# Copy this file to .env and fill in real values before deploying.

# Database connection. Use SQLite for local/dev, Postgres for staging/production.
# Dev:  sqlite:///./healthtrack.db
# Prod: postgresql://healthtrack_user:CHANGE_ME@db-host:5432/healthtrack
DATABASE_URL=sqlite:///./healthtrack.db

# Path to the trained Random Forest risk model artifact
RISK_MODEL_PATH=./app/risk_model.joblib

# Dashboard: base URL the Dash app uses to reach the API
API_BASE_URL=http://127.0.0.1:8000

# API host/port (used by run scripts)
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard host/port
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
